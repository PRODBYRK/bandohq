{
  "appId": "se.bandohq.app",
  "appName": "BANDOHQ",
  "webDir": "www",
  "backgroundColor": "#0b090e",
  "server": {
    "url": "https://www.bandohq.se",
    "errorPath": "offline.html",
    "allowNavigation": ["bandohq.se", "www.bandohq.se", "www.dropbox.com", "*.dropbox.com"]
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0b090e",
    "scheme": "BANDOHQ",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "PushNotifications": { "presentationOptions": ["badge", "sound", "alert"] },
    "SplashScreen": { "launchShowDuration": 600, "backgroundColor": "#0b090e", "showSpinner": false },
    "StatusBar": { "style": "DARK", "backgroundColor": "#0b090e", "overlaysWebView": true }
  }
}
